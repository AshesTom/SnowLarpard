#!/bin/bash
# SPDX-License-Identifier: LGPL-2.1-or-later
# The Snow Leopard session from a Wayland login manager, on a system without Xorg: KWin (or cage)
# as the compositor alone, an Xwayland of its own full screen (rootful), and the X session
# (snowleopard-session: WindowServer, the menu bar, the Finder, the Dock) on it. The session ends
# with SystemUIServer (Log Out), then Xwayland and the compositor.
#
#   snowleopard-wayland        what the login manager's session entry runs
#
# Restart and Shut Down act on the computer here (SNOWLEOPARD_POWER=1): this is a whole session.
set -uo pipefail
here=$(dirname -- "$(readlink -f -- "$0")")

if [[ -z ${SNOWLEOPARD_IN_COMPOSITOR:-} ]]; then
    export SNOWLEOPARD_IN_COMPOSITOR=1 XDG_SESSION_TYPE=wayland XDG_CURRENT_DESKTOP=SnowLeopard XDG_SESSION_DESKTOP=SnowLeopard
    # the compositor runs this script again inside it, and ends with it
    if command -v kwin_wayland >/dev/null; then
        # SNOWLEOPARD_KWIN_ARGS: more of KWin's options (--virtual --width 1280 --height 800 to try it
        # without a screen)
        # shellcheck disable=SC2086
        exec kwin_wayland --no-lockscreen --no-global-shortcuts --no-kactivities ${SNOWLEOPARD_KWIN_ARGS:-} --exit-with-session "$0"
    elif command -v cage >/dev/null; then
        exec cage -- "$0"
    fi
    echo "snowleopard-wayland: no compositor (kwin_wayland or cage)" >&2
    exit 1
fi

state=${XDG_STATE_HOME:-$HOME/.local/state}/snowleopard
mkdir -p "$state"
display=
for n in $(seq 1 50); do
    [[ -e /tmp/.X11-unix/X$n || -e /tmp/.X$n-lock ]] || { display=:$n; break; }
done
[[ -n $display ]] || { echo "snowleopard-wayland: no free X display" >&2; exit 1; }
# The output's size, for the X screen's (rootful Xwayland full screen scales its 640 x 480 otherwise):
# the compositor's current mode (wayland-info), else the first connected screen's preferred mode
size=${SNOWLEOPARD_SIZE:-}
if [[ -z $size ]] && command -v wayland-info >/dev/null; then
    size=$(wayland-info 2>/dev/null | awk '/width: .* px, height: .* px/ { w = $2; h = $5 } /flags: .*current/ && w { print w "x" h; exit }')
fi
if [[ -z $size ]]; then
    for c in /sys/class/drm/card*-*; do
        [[ $(cat "$c/status" 2>/dev/null) == connected ]] && { size=$(head -n1 "$c/modes" 2>/dev/null); break; }
    done
fi
# rootful, the whole output; the keyboard all the X session's (the compositor's shortcuts off)
Xwayland "$display" ${size:+-geometry "$size"} -fullscreen -host-grab -nolisten tcp >"$state/Xwayland.log" 2>&1 &
xwayland=$!
trap 'kill $xwayland 2>/dev/null' EXIT
for _ in $(seq 100); do
    [[ -e /tmp/.X11-unix/X${display#:} ]] && break
    sleep 0.05
done
DISPLAY=$display WAYLAND_DISPLAY= SNOWLEOPARD_POWER=${SNOWLEOPARD_POWER:-1} "$here/snowleopard-session"
