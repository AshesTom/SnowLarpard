#!/bin/bash
# SPDX-License-Identifier: LGPL-2.1-or-later
# The Snow Leopard session: the Finder's desktop, the Dock and SystemUIServer's menu bar. The session
# ends with SystemUIServer (Log Out).
#
#   snowleopard-session [--inside]     --inside: keep the current desktop's window manager
#
# On the current X display, the windows are managed by WindowServer (10.6's title bars); without it,
# by whichever EWMH window manager is installed. On the Wayland WindowServer (WindowServer-wayland
# runs it, SNOWLEOPARD_WINDOW_SERVER=wayland: snowleopard-wayland), every program is a Wayland one,
# the X11 ones on its Xwayland.
set -uo pipefail
root=$(cd -- "$(dirname -- "$(readlink -f -- "$0")")/.." && pwd)
# from the repository (.local/build/apps, .local/assets), or as install.sh lays it out (apps, assets)
if [[ -d $root/apps ]]; then
    apps=${SNOWLEOPARD_APPS:-$root/apps}
    export SNOWLEOPARD_ASSETS=${SNOWLEOPARD_ASSETS:-$root/assets}
else
    apps=${SNOWLEOPARD_APPS:-$root/.local/build/apps}
    export SNOWLEOPARD_ASSETS=${SNOWLEOPARD_ASSETS:-$root/.local/assets}
fi
[[ -x $apps/Dock.app/Contents/MacOS/Dock ]] || { echo "Build it first: $root/shell/build.sh" >&2; exit 1; }
[[ -e $SNOWLEOPARD_ASSETS/.complete ]] || echo "No DVD files in $SNOWLEOPARD_ASSETS (tools/extract.py): plain stand-ins instead" >&2
if [[ -z ${DBUS_SESSION_BUS_ADDRESS:-} ]] && command -v dbus-run-session >/dev/null; then
    exec dbus-run-session -- "$0" "$@"
fi
state=${XDG_STATE_HOME:-$HOME/.local/state}/snowleopard
mkdir -p "$state"
pids=() shell=() menubar=
cleanup() { kill ${menubar:+"$menubar"} "${shell[@]}" "${pids[@]}" 2>/dev/null; }
trap cleanup EXIT
trap 'exit 143' TERM INT HUP

export XDG_CURRENT_DESKTOP=SnowLeopard XDG_SESSION_DESKTOP=SnowLeopard
# 10.6's cursors (the window server's and HIServices', extract.py's theme), for the shell, AquaKit
# and the Qt and GTK applications alike
if [[ -d $SNOWLEOPARD_ASSETS/share/icons/SnowLeopard/cursors ]]; then
    export XCURSOR_PATH="$SNOWLEOPARD_ASSETS/share/icons:${XCURSOR_PATH:-$HOME/.local/share/icons:$HOME/.icons:/usr/share/icons}"
    export XCURSOR_THEME=SnowLeopard XCURSOR_SIZE=24
fi
# Linux's Qt 6 applications in Aqua: AquaStyle as a style plugin (apps/Linux/qt6/styles/aquastyle.so)
if [[ -e $apps/Linux/qt6/styles/aquastyle.so ]]; then
    export QT_PLUGIN_PATH="$apps/Linux/qt6${QT_PLUGIN_PATH:+:$QT_PLUGIN_PATH}" QT_STYLE_OVERRIDE=Aqua
fi
# shellcheck source=snowleopard-keyboard
source "$(dirname -- "$(readlink -f -- "$0")")/snowleopard-keyboard"
wayland=0
[[ ${SNOWLEOPARD_WINDOW_SERVER:-} == wayland && -n ${WAYLAND_DISPLAY:-} ]] && wayland=1
if ((wayland)); then
    # the Wayland session: the programs on the window server natively (Qt, AquaKit, GTK, Firefox,
    # Electron's ozone, SDL), X11 only for those without Wayland (DISPLAY: the window server's Xwayland)
    export XDG_SESSION_TYPE=wayland QT_QPA_PLATFORM="wayland;xcb" AQUAKIT_PLATFORM=wayland GDK_BACKEND=wayland,x11
    export MOZ_ENABLE_WAYLAND=1 ELECTRON_OZONE_PLATFORM_HINT=auto SDL_VIDEODRIVER=wayland,x11 CLUTTER_BACKEND=wayland
    unset SDL_VIDEO_X11_FORCE
else
    export QT_QPA_PLATFORM=xcb
    # an X session: AquaKit's applications (System Preferences) on its display too, under WindowServer
    export AQUAKIT_PLATFORM=x11
    # every program on this X display, none on the compositor under it (Xwayland's): Electron (its ozone
    # platform follows XDG_SESSION_TYPE), GTK, Firefox, SDL
    unset WAYLAND_DISPLAY
    export XDG_SESSION_TYPE=x11 ELECTRON_OZONE_PLATFORM_HINT=x11 GDK_BACKEND=x11 MOZ_ENABLE_WAYLAND=0 SDL_VIDEODRIVER=x11
fi

# The applications' menus go to the menu bar (SystemUIServer is com.canonical.AppMenu.Registrar):
# Qt does it by itself when the registrar is there, GTK 2 and 3 through appmenu-gtk-module.
for dir in /usr/lib/gtk-3.0/modules /usr/lib/x86_64-linux-gnu/gtk-3.0/modules; do
    if [[ -e $dir/libappmenu-gtk-module.so ]]; then
        export GTK_MODULES=${GTK_MODULES:+$GTK_MODULES:}appmenu-gtk-module UBUNTU_MENUPROXY=1
        break
    fi
done
if [[ ${1:-} != --inside ]] && ((!wayland)); then
    # WindowServer is the window manager and the compositor (the windows' shadows, the Dock's
    # translucency); without it, a compositor then a window manager.
    if [[ -x $apps/WindowServer ]]; then
        "$apps/WindowServer" >"$state/WindowServer.log" 2>&1 & pids+=($!)
    else
        for c in picom compton xcompmgr; do
            command -v $c >/dev/null && { $c >"$state/compositor.log" 2>&1 & pids+=($!); break; }
        done
        for wm in kwin_x11 xfwm4 openbox marco metacity fluxbox; do
            command -v $wm >/dev/null && { $wm >"$state/wm.log" 2>&1 & pids+=($!); break; }
        done
    fi
    # until it has the display, so that the shell's windows are managed from the start
    for _ in $(seq 40); do
        xprop -root _NET_SUPPORTING_WM_CHECK 2>/dev/null | grep -q 'window id' && break
        sleep 0.05
    done
fi
# the X display's keyboard (the Wayland window server has it from XKB_DEFAULT_*)
((wayland)) || apply_keyboard
# Software Update's tools (its catalog, its downloads, extract.py --update)
if [[ -z ${SNOWLEOPARD_TOOLS:-} ]]; then
    for t in "$root/tools" "$root/../tools"; do
        [[ -f $t/softwareupdate.py ]] && { export SNOWLEOPARD_TOOLS=$(cd -- "$t" && pwd); break; }
    done
fi
# Time Machine's engine: com.apple.backupd-auto's hourly backups (StartInterval 3600), while automatic
# backups are on (backupd checks timemachine.conf)
backupd="$apps/backupd.bundle/Contents/Resources/backupd"
[[ -x $backupd ]] && { "$backupd" --daemon >"$state/backupd.log" 2>&1 & pids+=($!); }
updater="$apps/Software Update.app/Contents/MacOS/Software Update"
rm -f -- "$state/install-updates"
while :; do
    # SystemUIServer first: its registrar must be there before applications start
    "$apps/SystemUIServer.app/Contents/MacOS/SystemUIServer" >"$state/SystemUIServer.log" 2>&1 &
    menubar=$!
    shell=()
    "$apps/Finder.app/Contents/MacOS/Finder" >"$state/Finder.log" 2>&1 & shell+=($!)
    "$apps/Dock.app/Contents/MacOS/Dock" >"$state/Dock.log" 2>&1 & shell+=($!)
    wait $menubar
    kill "${shell[@]}" 2>/dev/null
    wait "${shell[@]}" 2>/dev/null
    # Software Update's Restart (an update that installs at log out): what it downloaded, installed
    # over the login screen's picture; then the session starts again on the new files
    [[ -s $state/install-updates && -x $updater ]] || break
    "$updater" --install-at-logout >"$state/SoftwareUpdate.log" 2>&1
done
